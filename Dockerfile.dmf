# syntax=docker/dockerfile:1
# The mixer on the libmxl its MXL domain runs. Every reader and writer of one
# domain links the same libmxl, so the runtime is go-mxl-runtime, whose libmxl
# is the domain's, instead of the libmxl docker/Dockerfile builds. The mixer
# loads libmxl.so.1 at run time (the mxl crate's mxl-not-built feature), so the
# build stages below are docker/Dockerfile's, unchanged: keep them in step with
# it on an upstream merge.

# GO_MXL_TAG is the libmxl the rest of the domain runs, not a free choice.
ARG GO_MXL_TAG=1.1.0-rc.15

# MediaMTX (MIT) for the built-in preview server, the release tarball by checksum.
FROM ubuntu:24.04 AS mediamtx
ARG TARGETARCH=amd64
ARG MEDIAMTX_VERSION=v1.20.1
ARG MEDIAMTX_SHA256_AMD64=81b143f55a5d23d4a8c028d52869c14ea4a59919900528698fcc97a747fd69c6
ARG MEDIAMTX_SHA256_ARM64=d1689f0bfefb1864e5ed3dcc8495eb2d7ec0a654f90bf3cd48980cb3bd08718a
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    case "$TARGETARCH" in amd64) sum=$MEDIAMTX_SHA256_AMD64 ;; arm64) sum=$MEDIAMTX_SHA256_ARM64 ;; *) exit 1 ;; esac; \
    curl -fsSL -o /tmp/m.tgz "https://github.com/bluenviron/mediamtx/releases/download/${MEDIAMTX_VERSION}/mediamtx_${MEDIAMTX_VERSION}_linux_${TARGETARCH}.tar.gz"; \
    echo "$sum  /tmp/m.tgz" | sha256sum -c; \
    mkdir /opt/mediamtx && tar xzf /tmp/m.tgz -C /opt/mediamtx mediamtx LICENSE && rm /tmp/m.tgz

FROM node:22-bookworm-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/index.html web/vite.config.js ./
COPY web/src ./src
# The console's npm dependencies end up inside the mixer binary, where no
# scanner finds them: their CycloneDX fragment, from the lockfile, without
# the build-only ones.
RUN npm run build \
    && node -e ' \
        const lock = require("./package-lock.json"); \
        const components = Object.entries(lock.packages) \
          .filter(([path, p]) => path && !p.dev) \
          .map(([path, p]) => { \
            const name = path.replace(/^.*node_modules\//, ""); \
            const purl = `pkg:npm/${name.replace("@", "%40")}@${p.version}`; \
            return { type: "library", "bom-ref": purl, name, version: p.version, purl }; \
          }); \
        if (!components.length) throw new Error("no npm components"); \
        require("fs").mkdirSync("/sbom"); \
        require("fs").writeFileSync("/sbom/web.cdx.json", JSON.stringify( \
          { bomFormat: "CycloneDX", specVersion: "1.6", version: 1, components }));'

FROM ubuntu:24.04 AS build
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential cmake curl ca-certificates git pkg-config clang libclang-dev libssl-dev jq \
    && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.97.1
# cargo-auditable embeds each binary's crate list, so the image SBOM lists
# the crates the mixer is built from.
RUN cargo install --locked cargo-auditable --version 0.7.7
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml build.rs ./
COPY src ./src
COPY assets ./assets
COPY --from=web /web/dist/index.html ./web/dist/index.html
# ONNX Runtime (downloaded by ort-sys) and libopus (built from the copy in
# opusic-sys) are linked statically, and the crate list names only their
# wrappers: their CycloneDX fragment, with the versions this build used.
RUN cargo auditable build --release --locked --bins \
    && install -m 0755 target/release/mxl-audio-mixer target/release/mxl-mixer-tone \
        target/release/mxl-mixer-probe /usr/local/bin/ \
    && install -D -m 0644 "$(ls -d /opt/cargo/registry/src/*/opusic-sys-*/opus | head -1)/COPYING" \
        /usr/local/share/doc/libopus/COPYING \
    && target=$(rustc -vV | sed -n 's/^host: //p') \
    && ort=$(awk -F'\t' -v t="$target" '$1 == t && $2 == "none" { print $3 }' \
        /opt/cargo/registry/src/*/ort-sys-*/build/download/dist.tsv) \
    && ort=${ort#*/ms@} && ort=${ort%%/*} \
    && opus=$(sed -n 's/^PACKAGE_VERSION="\(.*\)"$/\1/p' /opt/cargo/registry/src/*/opusic-sys-*/opus/package_version) \
    && [ -n "$ort" ] && [ -n "$opus" ] \
    && mkdir -p /sbom \
    && jq -n --arg ort "$ort" --arg opus "$opus" '{bomFormat: "CycloneDX", specVersion: "1.6", version: 1, \
        components: [ \
          {type: "library", "bom-ref": "pkg:github/microsoft/onnxruntime@v\($ort)", name: "onnxruntime", \
           version: $ort, purl: "pkg:github/microsoft/onnxruntime@v\($ort)"}, \
          {type: "library", "bom-ref": "pkg:github/xiph/opus@v\($opus)", name: "libopus", \
           version: $opus, purl: "pkg:github/xiph/opus@v\($opus)"}]}' > /sbom/mixer.cdx.json

FROM ghcr.io/qvest-digital/go-mxl-runtime:${GO_MXL_TAG} AS runtime
ARG GO_MXL_TAG
ARG VERSION=dev
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates libstdc++6 libssl3t64 libcap2-bin \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /config && chown 1000:1000 /config
COPY --from=build /usr/local/bin/mxl-audio-mixer /usr/local/bin/mxl-mixer-tone \
    /usr/local/bin/mxl-mixer-probe /usr/local/bin/
COPY --from=mediamtx /opt/mediamtx/mediamtx /usr/local/bin/mediamtx
COPY --from=mediamtx /opt/mediamtx/LICENSE /usr/share/doc/mediamtx/LICENSE
COPY --from=web /sbom/ /opt/mxl-audio-mixer/share/sbom/
COPY --from=build /sbom/ /opt/mxl-audio-mixer/share/sbom/
# libopus (BSD-3-Clause) and ONNX Runtime (MIT, with its third-party notices)
# are linked statically into the mixer; the Silero VAD model (MIT) and
# Com-IS-Assist's control core (MIT) are in it.
COPY --from=build /usr/local/share/doc/libopus/COPYING /usr/share/doc/libopus/COPYING
COPY assets/onnxruntime.LICENSE /usr/share/doc/onnxruntime/LICENSE
COPY assets/onnxruntime.ThirdPartyNotices.txt /usr/share/doc/onnxruntime/ThirdPartyNotices.txt
COPY assets/silero_vad.LICENSE /usr/share/doc/silero-vad/LICENSE
COPY src/auto/comis/LICENSE /usr/share/doc/com-is-assist/LICENSE
# The mixer dlopens libmxl.so.1 by its soname. With SYS_NICE granted, the
# file capability below puts it in secure-execution mode, where the loader
# ignores LD_LIBRARY_PATH, so libmxl resolves through the ld.so cache instead.
# CAP_SYS_NICE is a permitted file capability only (+p): with SYS_NICE granted
# the mixer raises it for SCHED_FIFO as uid 1000, without it the binary still
# starts (SCHED_OTHER).
RUN echo /opt/libmxl/lib > /etc/ld.so.conf.d/libmxl.conf && ldconfig \
    && ldconfig -p | grep -q 'libmxl.so.1 ' \
    && ldd /opt/libmxl/lib/libmxl.so.1 | (! grep -q "not found") \
    && ldd /usr/local/bin/mxl-audio-mixer | (! grep -q "not found") \
    && setcap cap_sys_nice+p /usr/local/bin/mxl-audio-mixer \
    && getcap /usr/local/bin/mxl-audio-mixer | grep -q 'cap_sys_nice=p'

USER 1000
# Web/API, NMOS, the built-in MediaMTX's WHEP (TCP) and ICE (UDP).
EXPOSE 8190 3342 8599 8199/udp
LABEL org.opencontainers.image.source="https://github.com/qvest-digital/dmf-mf-mxl-audio-mixer" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}" \
      io.dmf.go-mxl.version="${GO_MXL_TAG}"
ENTRYPOINT ["/usr/local/bin/mxl-audio-mixer"]
